# ═══════════════════════════════════════════════════════════════
#  MealMarket — Environment Variables (Example)
#
#  Copy this file to `.env` and fill in the values.
#  The real `.env` is gitignored and must NEVER be committed.
# ═══════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/meal_db
DB_USERNAME=mealuser
DB_PASSWORD=mealpass123

# ─── Keycloak ─────────────────────────────────────────────────
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=mealmarket
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/mealmarket
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/mealmarket/protocol/openid-connect/certs
KEYCLOAK_ADMIN_TOKEN_PROVIDER_URI=http://localhost:8080/realms/mealmarket/protocol/openid-connect/token
KEYCLOAK_ADMIN_CLIENT_ID=meal-marketplace-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=your-keycloak-client-secret-here
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── MinIO / Garage ───────────────────────────────────────────
MINIO_URL=http://localhost:3900
MINIO_ACCESS_KEY=your-minio-access-key-here
MINIO_SECRET_KEY=your-minio-secret-key-here
MINIO_BUCKET=mealmarket-media
MINIO_PUBLIC_BASE_URL=http://mealmarket-media.web.garage.localhost:3902

# ─── MealMate AI (OpenRouter) ─────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-r1:free