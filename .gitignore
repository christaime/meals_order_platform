*.jar
*.war
*.ear
*.nar
*.log
hs_err_pid*
replay_pid*

# Gradle build artifacts (all submodules)
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
gradle-app.setting
.gradletasknamecache

# Maven (in case any module uses Maven)
